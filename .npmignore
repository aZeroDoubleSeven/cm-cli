# 排除 node_modules（使用通配符确保所有嵌套的 node_modules 都被排除）
**/node_modules/
node_modules/
src/mcp/node_modules/

# 排除锁文件
src/mcp/pnpm-lock.yaml
src/mcp/package-lock.json
src/mcp/yarn.lock
package-lock.json
yarn.lock
pnpm-lock.yaml

# 排除 Git 相关
.git/
.gitignore

# 排除编辑器文件
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.local

# 排除日志文件
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 排除测试文件
src/mcp/test-*.js
src/mcp/*.test.js

# 排除文档（可选，如果需要可以保留）
# docs/

# 排除临时文件
.DS_Store
*.swp
*.swo
*~
